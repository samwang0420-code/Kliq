# === 言镜 (Yanjing Recorder) 环境变量 ===
#
# 复制本文件为 .env 并填入你的 API key。
# .env 文件已在 .gitignore 中，不会被提交到仓库。
#
# 重要提示:
# - 所有 API key 仅存储在你的本地机器上
# - 言镜不会把你的 API key 上传到任何服务器
# - API 调用直接由你的 Electron 应用发起 → OpenAI / Anthropic / 自定义 base URL
# - 你的 API 配额由你自己掌控

# ===== OpenAI (转录 + 摘要) =====
# 必填: 用于 Whisper 转录 (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# 可选: 自定义 base URL (用于走 Azure OpenAI / 其他 OpenAI 兼容服务)
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选: 默认模型 (默认: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# 可选: Whisper 模型 (默认: whisper-1)
# OPENAI_WHISPER_MODEL=whisper-1

# ===== Anthropic Claude (替代摘要方案) =====
# 可选: 用于摘要与翻译 (https://console.anthropic.com/)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== 行业热词 (法律/医疗/电商/教育) =====
# 可选: 用于提升转录准确率与字幕质量
# 选填值: "general" | "legal" | "medical" | "ecommerce" | "education"
# DEFAULT_HOTWORDS_DOMAIN=general

# ===== 翻译目标语言 =====
# 可选: AI 双语字幕的目标语言 (默认: zh-CN)
# 可选: en | zh-CN | zh-TW | ja | ko | es | fr | de
# DEFAULT_TRANSLATION_LANG=zh-CN

# ===== Lemon Squeezy 支付 =====
# 可选: 用于 Pro tier 许可证激活 (https://lemonsqueezy.com)
# LEMON_SQUEEZY_STORE=
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_PRODUCT_ID=

# ===== 调试 =====
# 可选: 启用调试日志
# DEBUG=yanjing:*
